
{
  "manifest_version": 3,
  "name": "FormCheck AI",
  "version": "1.0.0",
  "description": "Check online forms for missing and invalid information before submission.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://formcheckai-32co.onrender.com/*",
    "http://127.0.0.1:5000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FormCheck AI"
  }
}
